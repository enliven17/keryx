# Neon PostgreSQL connection string. Keep it in server/.env or your deployment secret store.
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/keryx?sslmode=require

# Which deployment to use: anvil for local development or creditcoin for CTC testnet.
KERYX_NETWORK=anvil
PORT=4021
PUBLIC_URL=http://localhost:4021

# Target settlement chain. Addresses are read from contracts/deployments/<network>.json.
# CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# CHAIN_ID=102031
# USDC_ADDRESS=0x...
# CAMPAIGN_ESCROW=0x...
# AUCTION_HOUSE=0x...
# ATTESTCOIN_SETTLEMENT=0x...
# SOURCE_ENGAGEMENT=0x...
# TREASURY=0x...
# DEPLOYER_PRIVATE_KEY=0x...

# Source chain and Attestcoin proof worker.
SOURCE_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Attestcoin source chain keys on cc3-testnet: 1 = Ethereum Sepolia, 3 = Ethereum mainnet.
SOURCE_CHAIN_ID=11155111
SOURCE_CHAIN_KEY=1
CREDITCOIN_PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network
SOURCE_START_BLOCK=0
SOURCE_POLL_MS=15000
SOURCE_ENGAGEMENT_PRIVATE_KEY=0x...

# Earning and batch controls.
PER_EARNER_DAILY_CAP=50000
SETTLE_MIN_IMPRESSIONS=1
SETTLE_INTERVAL_MS=15000
VIEW_THRESHOLD_MS=3000
